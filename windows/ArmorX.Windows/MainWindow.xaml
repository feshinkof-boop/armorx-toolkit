<Window x:Class="ArmorX.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArmorX Windows" Width="1220" Height="860" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ArmorX Windows" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Public configurator · v0.2.1" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="Auto-backup · exact diff · read-back verified" Foreground="{StaticResource TextSecondary}"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Device" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ConnectionHeadline}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding ConnectionDetail}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>

                    <UniformGrid Columns="4" Margin="0,16,0,0">
                        <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="MODEL" FontSize="10" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="{Binding ModelText}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="FIRMWARE" FontSize="10" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="{Binding FirmwareText}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="BATTERY" FontSize="10" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="{Binding BatteryText}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="12">
                            <StackPanel><TextBlock Text="CONFIG" FontSize="10" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="{Binding Config.CrcStatus, Mode=OneWay}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center" MinWidth="245">
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" Content="Connect / Recover" Click="ConnectRecover_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Content="Read from device" Click="ReadConfig_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Content="Review pending changes" Click="ReviewChanges_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Background="{StaticResource Success}" BorderBrush="{StaticResource Success}" Content="Apply &amp; Verify" Click="WriteVerify_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Content="Restore last backup" Click="RestoreLastBackup_Click"/>
                    <Button Style="{StaticResource DangerButton}" Margin="0" Content="Disconnect" Click="Disconnect_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8">
            <TabItem Header="Sticks">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Stick limits &amp; deadzones" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Raw controller values (0-255). Unknown vendor UI scaling is intentionally not guessed." Foreground="{StaticResource TextSecondary}" Margin="0,3,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Circle limit"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.JoystickCircleLimit}"/><TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.JoystickCircleLimit}"/>
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Stick turn"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.StickTurn}"/><TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.StickTurn}"/>
                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Left deadzone center"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.LeftStickDeadzoneCenter}"/><TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.LeftStickDeadzoneCenter}"/>
                                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Left deadzone side"/><Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.LeftStickDeadzoneSide}"/><TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.LeftStickDeadzoneSide}"/>
                                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Right deadzone center"/><Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.RightStickDeadzoneCenter}"/><TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.RightStickDeadzoneCenter}"/>
                                    <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Right deadzone side"/><Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.RightStickDeadzoneSide}"/><TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.RightStickDeadzoneSide}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Left stick curve" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Config.LeftStickCurve}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{Binding Label}"/><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Value}"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Value}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Right stick curve" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Config.RightStickCurve}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{Binding Label}"/><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Value}"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Value}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Triggers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Trigger settings" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Raw controller values (0-255)." Foreground="{StaticResource TextSecondary}" Margin="0,3,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Trigger mode"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.TriggerMode}"/><TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.TriggerMode}"/>
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Left deadzone center"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.TriggerLeftDeadzoneCenter}"/><TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.TriggerLeftDeadzoneCenter}"/>
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Left deadzone side"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.TriggerLeftDeadzoneSide}"/><TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.TriggerLeftDeadzoneSide}"/>
                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Right deadzone center"/><Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.TriggerRightDeadzoneCenter}"/><TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.TriggerRightDeadzoneCenter}"/>
                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Right deadzone side"/><Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.TriggerRightDeadzoneSide}"/><TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.TriggerRightDeadzoneSide}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Gyro">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Gyro / sensor" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Sensor mode"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.SensorMode}"/><TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.SensorMode}"/>
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Sensor direction"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.SensorDir}"/><TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.SensorDir}"/>
                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Sensor right key 0"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.SensorRightKey0}"/><TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.SensorRightKey0}"/>
                                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Sensor right key 1"/><Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.SensorRightKey1}"/><TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.SensorRightKey1}"/>
                                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Sensor minimum"/><Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.SensorMin}"/><TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.SensorMin}"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Sensor right key bitmask"/><TextBox Grid.Column="1" Text="{Binding Config.SensorRightKeyBit, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0" Text="Sensor switch bitmask"/><TextBox Grid.Column="3" Text="{Binding Config.SensorSwitch, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Curve 1" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding Config.GyroCurve0}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Width="40" Text="{Binding Label}"/><Slider Width="190" Minimum="0" Maximum="255" Value="{Binding Value}"/><TextBlock Width="42" Text="{Binding Value}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Curve 2" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding Config.GyroCurve1}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Width="40" Text="{Binding Label}"/><Slider Width="190" Minimum="0" Maximum="255" Value="{Binding Value}"/><TextBlock Width="42" Text="{Binding Value}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Curve 3" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding Config.GyroCurve2}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Width="40" Text="{Binding Label}"/><Slider Width="190" Minimum="0" Maximum="255" Value="{Binding Value}"/><TextBlock Width="42" Text="{Binding Value}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Turbo">
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Turbo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Turbo speed index"/><Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Config.TurboSpeedIdx}"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Config.TurboSpeedIdx}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Turbo key bitmask"/><TextBox Grid.Column="1" Text="{Binding Config.TurboKey, UpdateSourceTrigger=LostFocus}"/></Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Rear Buttons">
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="M1-M4 remapping" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Only mappings supported by current public evidence are shown. Guide / Xbox is live-proven as ID 12." Foreground="{StaticResource TextSecondary}" Margin="0,3,0,18"/>
                        <Grid MaxWidth="760" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="M1"/><ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding MappingTargets}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Config.M1TargetId}"/>
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="M2"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding MappingTargets}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Config.M2TargetId}"/>
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="M3"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding MappingTargets}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Config.M3TargetId}"/>
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="M4"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding MappingTargets}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Config.M4TargetId}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Profiles">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Save profile" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Profiles are stored only on this PC." Foreground="{StaticResource TextSecondary}" Margin="0,3,0,12"/>
                            <TextBlock Text="Name" FontWeight="SemiBold"/><TextBox x:Name="ProfileNameBox" Text="My ArmorX Profile"/>
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,10,0,8" Content="Save current profile" Click="SaveProfile_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Content="Refresh profiles" Click="RefreshProfiles_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0" Content="Open profiles folder" Click="OpenProfilesFolder_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="Saved profiles" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Loading a profile changes the editor only. It does not write the controller until you click Apply &amp; Verify." Foreground="{StaticResource TextSecondary}" Margin="0,3,0,12" TextWrapping="Wrap"/></StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" BorderBrush="{StaticResource BorderBrushSoft}">
                                <ListBox.ItemTemplate><DataTemplate><Border Padding="10"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}"><Run Text="Saved: "/><Run Text="{Binding SavedUtc}"/><Run Text="    Model: "/><Run Text="{Binding DeviceModel}"/><Run Text="    Firmware: "/><Run Text="{Binding Firmware}"/></TextBlock></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Content="Load selected into editor" Click="LoadProfile_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}"/>
                    <TextBlock Text="{Binding SafetyText}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Text="Unknown config bytes are preserved from the device image."/>
            </Grid>
        </Border>
    </Grid>
</Window>
